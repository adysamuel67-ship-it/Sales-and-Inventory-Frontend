{
  "expo": {
    "name": "Business Bot",
    "slug": "business-bot-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "businessbot",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.businessbot.salesinventory",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Business Bot needs camera access to scan products",
        "NSPhotoLibraryUsageDescription": "Business Bot needs photo access to upload product images"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "package": "com.businessbot.salesinventory",
      "versionCode": 1,
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Business Bot needs access to your photos to upload product images",
          "cameraPermission": "Business Bot needs camera access to take product photos"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
